# Copy this file to .env and fill in your own keys.
# .env is gitignored and must never be committed.

# Groq — LLM (Llama 3.3 70B) + Whisper transcription
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Inference — sentence-transformers embeddings
HF_API_KEY=your_huggingface_api_key_here

# Supabase — pgvector knowledge base
SUPABASE_KEY=your_supabase_service_key_here

# Your n8n instance base URL, e.g. https://n8n.example.com
N8N_HOST=https://your-n8n-host
