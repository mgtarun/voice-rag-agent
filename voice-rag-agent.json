{
  "name": "Voice RAG Agent (Furniture Sales Demo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-incoming",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
