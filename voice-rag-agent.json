      ],
      "id": "3fc741b1-1be7-4509-8a43-fefcf5cbdef5",
      "name": "Webhook",
      "webhookId": "bf19ef04-332b-45fd-a361-6ba08cc1d4b8"
    },
    {
      "parameters": {
        "jsCode": "const twiml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say voice=\"Google.en-US-Neural2-F\">\n    Welcome to Lumen Living. Please speak your question after the beep and we will get back to you shortly.\n  </Say>\n  <Record \n    action=\"https://YOUR_N8N_HOST/webhook/voice-recording\"\n    maxLength=\"20\"\n    playBeep=\"true\"\n    transcribe=\"true\"\n    transcribeCallback=\"https://YOUR_N8N_HOST/webhook/voice-transcription\"\n  />\n</Response>`;\n\nreturn [{ json: { twiml } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "cff1dc36-da08-4cfd-b687-b6aff0c6ac23",
      "name": "Generate Greeting"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{$json.twiml}}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "=Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        416,
        0
      ],
      "id": "890dfdea-ff31-431a-b796-aa593b8bcce9",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-recording",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        16,
        208
      ],
      "id": "46dcc015-00fd-4bf2-8d47-ced81cd62d9d",
      "name": "Webhook1",
      "webhookId": "bd979125-5e70-4c8d-a41e-d3c377fb1a11"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst recordingUrl = body.RecordingUrl || '';\nconst from = body.From || '';\nconst callSid = body.CallSid || '';\n\nconst twiml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say voice=\"Google.en-US-Neural2-F\">\n    Thank you for your question. We will send you a reply by text message shortly. Goodbye.\n  </Say>\n  <Hangup/>\n</Response>`;\n\nreturn [{ json: { twiml, recordingUrl, from, callSid } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        208
      ],
      "id": "bde7c988-45db-4765-81e4-cb113cf56a95",
      "name": "Thank You Message"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{$json.twiml}}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        480,
        208
      ],
      "id": "8dfc7819-c19e-400a-a07a-8ee8e88c4d8d",
      "name": "Respond to Webhook1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HF_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"inputs\": \"{{$json.text}}\"}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        432,
        480
      ],
      "id": "105a3b2e-9cf2-4da5-977e-94bd26e4b923",
      "name": "Generate Embedding"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst vector = allItems.map(item => item.json);\nconst vectorString = '[' + vector.join(',') + ']';\n\nconst matches = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://YOUR_PROJECT.supabase.co/rest/v1/rpc/match_knowledge',\n  headers: {\n    'apikey': process.env.SUPABASE_KEY,\n    'Authorization': 'Bearer ' + process.env.SUPABASE_KEY,\n    'Content-Type': 'application/json'\n  },\n  body: { query_embedding: vectorString, match_count: 4 },\n  json: true\n});\n\nconst transcript = $('HTTP Request').first()?.json?.text || '';\nconst from = $('Thank You Message').first()?.json?.from || '';\nconst queryLower = transcript.toLowerCase();\nconst boosted = matches.map(r => {\n  let boost = 0;\n  const product = (r.product || '').toLowerCase();\n  if (product.includes('sofa') && queryLower.includes('sofa')) boost += 10;\n  if (product.includes('dining') && queryLower.includes('dining')) boost += 10;\n  if (product.includes('oslo') && queryLower.includes('oslo')) boost += 15;\n  if (product.includes('stilt') && queryLower.includes('stilt')) boost += 15;\n  if (product.includes('arc') && queryLower.includes('arc')) boost += 15;\n  if (product.includes('chess') && queryLower.includes('chess')) boost += 15;\n  if (product.includes('bed') && queryLower.includes('bed')) boost += 10;\n  if (r.category === 'pricing') boost += 2;\n  if (r.category === 'lead_times') boost += 2;\n  return { ...r, boost };\n});\nconst reranked = boosted.sort((a, b) => b.boost - a.boost);\nconst context = reranked.map(r => r.content).join(' | ').replace(/\\n/g, ' ').replace(/\u2013/g, '-').replace(/\"/g, \"'\");\nreturn [{ json: { context, transcript, from } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        480
      ],
      "id": "1686d3e3-0a6e-4804-b799-bf9e2ae10459",
      "name": "Vector Search"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"stream\": false,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a friendly sales assistant for Lumen Living, a modern furniture brand.\\n\\nA customer called and left a voice message. Answer their question using the product information below.\\n\\nRULES:\\n- Be warm, helpful and concise \u2014 2 to 3 sentences maximum\\n- Include specific pricing or lead times if relevant and available\\n- If the context does not contain the answer, say you will follow up and direct them to lumenliving.example\\n- This will be sent as an SMS so do NOT use bullet points, markdown, or special characters\\n- Write in natural conversational English only\\n- End with: For more details visit lumenliving.example or reply to this message.\\n\\nCustomer question: {{$json.transcript}}\\n\\nProduct context:\\n{{$json.context}}\"\n    }\n  ],\n  \"temperature\": 0.4,\n  \"max_tokens\": 300\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        800,
        480
      ],
      "id": "5dc3a191-c3fa-47cb-865d-f23014ee95c4",
      "name": "LLM Voice Reply"
    },
    {
      "parameters": {
        "jsCode": "const reply = $input.first().json.choices?.[0]?.message?.content ?? '';\nconst from = $('Thank You Message').first()?.json?.from || '';\nreturn [{ json: { reply, from } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
